{
  "$id": "constants/topicPath.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Topic path for OI4 MQTT messages. ADR 003: Supports both Oi4 (legacy) and Oi4v2 (versioned) namespace prefixes.",
  "type": "string",
  "pattern": "^Oi4\\/(Registry|OTConnector|Utility|Persistence|Aggregation|OOCConnector|ITConnector|\\+|#)\\/(((([a-z0-9-]+\\.)*([a-z0-9-]*))|\\+|#)(?:\\/[^\\/`\\^\r\n]+){3})\\/(Pub|Get|Set|Del|Call|Reply|\\+|#)\\/(MAM|Health|Config|Data|Metadata|Event|Profile|PublicationList|SubscriptionList|ReferenceDesignation|AAS|FileUpload|FileDownload|FirmwareUpdate|Blink|NewDataSetWriterId|\\+|#)(.*)$"
}