{
  "$id": "constants/topicPath.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Topic path for OI4 MQTT messages.",
  "type": "string",
  "pattern": "^Oi4v2\\/(Registry|OTConnector|Utility|Persistence|Aggregation|OOCConnector|ITConnector|\\+|#)\\/(((([a-z0-9-]+\\.)*([a-z0-9-]*))|\\+|#)(?:\\/[^\\/`\\^\r\n]+){3})\\/(Pub|Get|Set|Del|Call|Reply|\\+|#)\\/(MAM|Health|Config|Data|Metadata|Event|Profile|PublicationList|SubscriptionList|ReferenceDesignation|AAS|FileUpload|FileDownload|FirmwareUpdate|Blink|NewDataSetWriterId|\\+|#)(.*)$"
}